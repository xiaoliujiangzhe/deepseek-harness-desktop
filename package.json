{
  "name": "deepseek-harness-desktop",
  "version": "0.4.0",
  "description": "DeepSeek Harness desktop shell with a split embedded browser, guarded plugin center, portable Node runtime, and native startup workspace.",
  "author": "DSH Desktop",
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "image:whale-girl": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-whale-girl.ps1",
    "verify:plugin-github": "electron scripts/verify-github-plugin-install.js",
    "verify:harness": "node scripts/verify-harness-version.js",
    "runtime:node": "node scripts/stage-portable-node.js",
    "icon:build": "electron scripts/render-brand-assets.js",
    "prestart": "npm run verify:harness",
    "start": "electron .",
    "prestart:debug": "npm run verify:harness",
    "start:debug": "electron . --enable-logging",
    "test": "node --test test/*.test.js",
    "predist": "npm run verify:harness",
    "dist": "electron-builder",
    "predist:win": "npm run verify:harness && npm run runtime:node && npm run icon:build",
    "dist:win": "electron-builder --win",
    "postdist:win": "node scripts/verify-packaged-harness.js"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "1.0.1",
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.1-rc.2",
    "@deepseek-ai/dsh-atomic-write": "0.1.1-rc.2",
    "@deepseek-ai/dsh-authorization": "0.1.1-rc.2",
    "@deepseek-ai/dsh-bash-local": "0.1.1-rc.2",
    "@deepseek-ai/dsh-code-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-compaction": "0.1.1-rc.2",
    "@deepseek-ai/dsh-fs": "0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "@deepseek-ai/dsh-output-retention": "0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.1.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-telemetry": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-title-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-shell": "0.1.1-rc.2",
    "@deepseek-ai/dsh-spill": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent-in-process-driver": "0.1.1-rc.2",
    "@deepseek-ai/dsh-timeout": "0.1.1-rc.2",
    "@deepseek-ai/dsh-workflow": "0.1.1-rc.2",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "pnpm": "11.21.0"
  },
  "build": {
    "appId": "com.dsh.desktop",
    "productName": "DeepSeek Harness",
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/**/*"
    ],
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "runtime/node",
        "to": "runtime/node",
        "filter": [
          "node.exe",
          "runtime.json"
        ]
      },
      {
        "from": "node_modules/pnpm",
        "to": "runtime/pnpm/package",
        "filter": [
          "bin/**/*",
          "dist/**/*",
          "LICENSE",
          "package.json"
        ]
      },
      {
        "from": "scripts/pnpm-runtime.cmd",
        "to": "runtime/pnpm/pnpm.cmd"
      }
    ],
    "directories": {
      "output": "release"
    },
    "artifactName": "DeepSeek-Harness-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "xiaoliujiangzhe",
        "repo": "deepseek-harness-desktop",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
